{
  "name": "infinite-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-independent agent architecture for function calling, relational database retrieval, and accumulated requests.",
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "docs:build": "python3 docs/source/career/build_plan.py && node scripts/render-plan.cjs",
    "docs:check": "node scripts/render-plan.cjs --check-only",
    "docs:serve": "python3 -m http.server 8848 --bind 127.0.0.1 --directory docs",
    "docs:render-pdf": "node scripts/render-pdf.cjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149",
    "playwright": "1.56.1"
  }
}
